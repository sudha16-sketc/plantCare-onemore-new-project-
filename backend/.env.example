# API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
NOTEBOOKLM_API_KEY=your_notebooklm_api_key_here

# Server Configuration
DEBUG=true

# MongoDB Atlas Configuration
# IMPORTANT: Special characters in password must be URL-encoded
# Example: If password is "pass@word", encode @ as %40 -> "pass%40word"
# 
# Other special characters to encode:
# @ -> %40
# : -> %3A
# / -> %2F
# ? -> %3F
# # -> %23
# & -> %26
# = -> %3D
# 
# MongoDB Atlas Connection String Format:
# mongodb+srv://USERNAME:PASSWORD@CLUSTERNAME.mongodb.net/?appName=APPNAME
# 
# Example (with encoded password):
# MONGODB_URI=mongodb+srv://user:pass%40word@cluster.mongodb.net/?appName=app
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=plantcare
MONGODB_DB=plantcare

# Notes on MongoDB Atlas Setup:
# 1. Create a database user in MongoDB Atlas
# 2. Use URL encoding for special characters in password  
# 3. Add your IP to IP Whitelist (Network Access tab)
# 4. Copy connection string from "Connect" -> "Drivers" -> "Python"
# 5. Replace USERNAME, PASSWORD, and CLUSTERNAME with your values
