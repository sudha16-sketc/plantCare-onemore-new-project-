# PlantCare backend configuration — EXAMPLE (placeholders only)
# Copy to .env and fill in real values. Never commit .env.

# --- AI (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Server ---
DEBUG=false
HOST=0.0.0.0
PORT=8000

# --- CORS (comma-separated browser origins that may call this API) ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_random_64_char_hex
JWT_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12

# --- Database (MongoDB Atlas or local MongoDB) ---
# Leave MONGODB_URI empty to run with in-memory storage (dev/demo only —
# /ready will report storage_mode: "memory"; data is lost on restart).
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=plantcare
MONGODB_DB=plantcare
MONGODB_TIMEOUT_MS=5000

# --- AI behaviour ---
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45
# When true AND no GEMINI_API_KEY is set, AI endpoints return clearly-labeled
# mock payloads (source="mock"). NEVER enable in production.
ALLOW_MOCK_AI=false

# --- Uploads / limits ---
MAX_UPLOAD_BYTES=8388608
MAX_REQUEST_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- Rate limiting (AI endpoints) ---
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60

# --- Rate limiting (auth endpoints) ---
# Per-IP cap across /register + /login within the window.
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Per-account failed-login lockout (applies to unknown emails as well).
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=300

# --- Generated files (PPT) ---
GENERATED_DIR=generated_files
GENERATED_FILE_TTL_SECONDS=3600

# --- Notes on MongoDB Atlas ---
# 1. Create a database user; URL-encode special characters in the password
#    (@ -> %40, : -> %3A, / -> %2F, ? -> %3F, # -> %23, & -> %26, = -> %3D)
# 2. Add your IP to the Network Access list
# 3. Copy the connection string from Connect -> Drivers -> Python
