## Integration Examples

### JavaScript/Fetch
```javascript
const plantData = {
  plant_name: "Basil",
  plant_type: "Herb",
  climate: "Mediterranean",
  sunlight_hours: 6,
  soil_type: "Well-draining",
  watering_frequency: "Every 2 days",
  experience_level: "Beginner"
};

fetch('http://localhost:8000/generate-plant-guide', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify(plantData)
})
  .then(response => response.json())
  .then(data => {
    console.log('Plant Guide:', data);
  })
  .catch(error => {
    console.error('Error:', error);
  });
```

### Python/Requests
```python
import requests

plant_data = {
    "plant_name": "Basil",
    "plant_type": "Herb",
    "climate": "Mediterranean",
    "sunlight_hours": 6,
    "soil_type": "Well-draining",
    "watering_frequency": "Every 2 days",
    "experience_level": "Beginner"
}

response = requests.post(
    'http://localhost:8000/generate-plant-guide',
    json=plant_data
)

if response.status_code == 200:
    data = response.json()
    print(f"Success: {data['success']}")
    print(f"Plant: {data['metadata']['plant_name']}")
else:
    print(f"Error: {response.status_code}")
```

### cURL
```bash
curl -X POST "http://localhost:8000/generate-plant-guide" \
  -H "Content-Type: application/json" \
  -d '{
    "plant_name": "Basil",
    "plant_type": "Herb",
