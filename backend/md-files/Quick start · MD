## 🤝 Frontend Integration

### Fetch Example
```javascript
const response = await fetch('http://localhost:8000/generate-plant-guide', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify(plantData)
});

const guide = await response.json();
```

### Axios Example
```javascript
const guide = await axios.post(
  'http://localhost:8000/generate-plant-guide',
  plantData
);
```

### React Hook Example
```javascript
const [guide, setGuide] = useState(null);
const [loading, setLoading] = useState(false);

const generateGuide = async (plantData) => {
  setLoading(true);
  try {
    const response = await fetch('http://localhost:8000/generate-plant-guide', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(plantData)
    });
    const data = await response.json();
    setGuide(data);
  } catch (error) {
    console.error('Error:', error);
  } finally {
    setLoading(false);
  }
};
```

